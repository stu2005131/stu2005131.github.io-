<%- include('header', {user}) %>
<h2>My Questions <% if(filter){ %>(filter: <%= filter %>)<% } %></h2>
<ul>
  <% questions.forEach(q => { %>
    <li class="question">
      <div>#<%= q.id %> - <%= q.tags.join(', ') %></div>
      <div><a href="/question/<%= q.id %>">View</a></div>
    </li>
  <% }) %>
</ul>
<%- include('footer') %>
